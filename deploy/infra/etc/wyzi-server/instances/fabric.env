# Wyzi Minecraft instance: fabric
# Fabric 26.1.2 (loader 0.19.3) survival world, migrated 2026-10-06 from /opt/minecraft-fabric/server.
# Server files: /srv/minecraft/instances/fabric/   Unit: wyzi-mc@fabric.service
# Network port / RCON are defined in server.properties (server-port=25565, rcon.port=25575).
INSTANCE_DESC="Fabric 26.1.2 survival (legacy world)"

JAVA=/usr/lib/jvm/java-25-openjdk-amd64/bin/java
XMS=2G
XMX=6G
JVM_FLAGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:InitiatingHeapOccupancyPercent=15 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1"

LAUNCH_MODE=jar
SERVER_JAR=fabric-server-launch.jar
SERVER_ARGS=nogui

# Heavy instances (big modpacks) are mutually exclusive with each other.
HEAVY=no
STOP_TIMEOUT=240

# Backups (paths relative to the instance dir)
BACKUP_EXCLUDES="logs crash-reports bluemap/web/maps .fabric/remappedJars"
BACKUP_KEEP=14
BACKUP_KEEP_MANUAL=20
