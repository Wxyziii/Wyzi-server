# Template for a new Wyzi Minecraft instance.
# Copy to /etc/wyzi-server/instances/<name>.env  (name: ^[a-z0-9][a-z0-9-]{0,31}$)
# and put the server files in /srv/minecraft/instances/<name>/ (owner minecraft:minecraft).
INSTANCE_DESC="Describe me"

# Java per instance. Installed: java-17-openjdk-amd64, java-21-openjdk-amd64, java-25-openjdk-amd64
#   MC 1.20.4 and older -> 17 | MC 1.20.5 - 1.21.x -> 21 | MC 26.x -> 25
JAVA=/usr/lib/jvm/java-21-openjdk-amd64/bin/java
XMS=4G
XMX=8G
JVM_FLAGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:InitiatingHeapOccupancyPercent=15 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1"

# jar  -> SERVER_JAR=<file in instance dir>        (Fabric, Quilt, vanilla, Paper)
# args -> LAUNCH_ARGS="@libraries/.../unix_args.txt" (Forge / NeoForge)
LAUNCH_MODE=jar
SERVER_JAR=fabric-server-launch.jar
#LAUNCH_ARGS=
SERVER_ARGS=nogui

HEAVY=yes
STOP_TIMEOUT=300

BACKUP_EXCLUDES="logs crash-reports"
BACKUP_KEEP=14
BACKUP_KEEP_MANUAL=20

# Required in server.properties for graceful stop + consistent live backups:
#   enable-rcon=true  rcon.port=<unique per instance>  rcon.password=<random>
#   server-ip=        (leave EMPTY - interface independent; firewall controls exposure)
