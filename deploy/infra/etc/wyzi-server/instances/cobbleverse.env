# Wyzi Minecraft instance: cobbleverse
# Cobbleverse 1.7.42 (Fabric 1.21.1, loader 0.18.4, Cobblemon 1.7.3) + POKÉ PORTAL, migrated 2026-10-07 from the PC.
# Server files: /srv/minecraft/instances/cobbleverse/   Unit: wyzi-mc@cobbleverse.service
# Network port / RCON are defined in server.properties (server-port=25565, rcon.port=25576).
# Shares port 25565 with "fabric": only one of them can run at a time.
INSTANCE_DESC="Cobbleverse - Pokemon adventure"

JAVA=/usr/lib/jvm/java-21-openjdk-amd64/bin/java
XMS=4G
XMX=8G
JVM_FLAGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:InitiatingHeapOccupancyPercent=15 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1"

LAUNCH_MODE=jar
SERVER_JAR=fabric-server-launch.jar
SERVER_ARGS=nogui

# Heavy instances (big modpacks) are mutually exclusive with each other.
HEAVY=yes
STOP_TIMEOUT=300

# Backups (paths relative to the instance dir)
BACKUP_EXCLUDES="logs crash-reports .fabric/remappedJars stackdeobf_mappings"
BACKUP_KEEP=14
BACKUP_KEEP_MANUAL=20
